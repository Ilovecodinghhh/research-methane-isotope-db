         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Atmospheric Composition and Structure: Constituent sources and sinks; Atmospheric Composition and Structure: Troposphere: composition and chemistry; Atmospheric Composition and Structure: Troposphere: constituent transport and chemistry; Atmospheric Processes: Ocean/atmosphere interactions</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Methane carbon isotope effects caused by atomic chlorine in the marine boundary layer: Global model results compared with Southern Hemisphere measurements</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>W. Allan, H. Struthers, D. C. Lowe</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
