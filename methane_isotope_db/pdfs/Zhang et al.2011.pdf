         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Biogeosciences: Agricultural systems; Biogeosciences: Biogeochemical cycles, processes, and modeling; Biogeosciences: Carbon cycling; Biogeosciences: Isotopic composition and chemistry; Geochemistry: Stable isotope geochemistry</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Carbon isotopic composition, methanogenic pathway, and fraction of CH&lt;subscr&gt;4&lt;/subscr&gt; oxidized in a rice field flooded year-round</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
