            <rdf:Alt>
               <rdf:li xml:lang="x-default">Atmospheric Composition and Structure: Troposphere: composition and chemistry; Atmospheric Composition and Structure: Instruments and techniques; Geochemistry: Stable isotope geochemistry; Oceanography: Biological and Chemical: Stable isotopes; Biogeosciences: Trace gases; Global Change: Atmosphere</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Stable isotope ratios in atmospheric CH&lt;subscr&gt;4&lt;/subscr&gt;: Implications for seasonal sources and sinks</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
