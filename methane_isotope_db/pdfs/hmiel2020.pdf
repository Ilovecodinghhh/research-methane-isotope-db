        <article lang="en">
            
            <div class="c-article-header">
                <header>
                    <ul class="c-article-identifiers" data-test="article-identifier">
                        
        <li class="c-article-identifiers__item" data-test="article-category">Article</li>
    
    

                        <li class="c-article-identifiers__item">Published: <time datetime="2020-02-19">19 February 2020</time></li>
                    </ul>

                    <h1 class="c-article-title" data-test="article-title" data-article-title="">Preindustrial <sup>14</sup>CH<sub>4</sub> indicates greater anthropogenic fossil CH<sub>4</sub> emissions</h1>
                    <ul class="c-article-author-list c-article-author-list--short" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="1_19" data-track-context="researcher popup with no profile" href="#auth-Benjamin-Hmiel-Aff1" data-author-popup="auth-Benjamin-Hmiel-Aff1" data-author-search="Hmiel, Benjamin" data-corresp-id="c1">Benjamin Hmiel<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><sup class="u-js-hide"><a href="#Aff1">1</a></sup>, </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="2_19" data-track-context="researcher popup with no profile" href="#auth-V__V_-Petrenko-Aff1" data-author-popup="auth-V__V_-Petrenko-Aff1" data-author-search="Petrenko, V. V.">V. V. Petrenko</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="3_19" data-track-context="researcher popup with no profile" href="#auth-M__N_-Dyonisius-Aff1" data-author-popup="auth-M__N_-Dyonisius-Aff1" data-author-search="Dyonisius, M. N.">M. N. Dyonisius</a><sup class="u-js-hide"><a href="#Aff1">1</a></sup>, </li><li class="c-article-author-list__item c-article-author-list__item--hide-small-screen"><a data-test="author-name" data-track="click" data-track-action="open author" data-track-label="link" data-track-index="4_19" data-track-context="researcher popup with no profile" href="#auth-C_-Buizert-Aff2" data-author-popup="auth-C_-Buizert-Aff2" data-author-searc